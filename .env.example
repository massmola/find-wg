# IMAP details for the mailbox receiving WG-Gesucht and page-monitor alerts.
# Gmail: use imap.gmail.com and an app password, not your normal password.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=replace-with-an-app-password
IMAP_FOLDER=INBOX

# Create a bot with Telegram's @BotFather, send it one message, then obtain your
# chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=replace-with-telegram-token
TELEGRAM_CHAT_ID=replace-with-chat-id

MAX_RENT_EUR=700
# Whole-apartment searches use total advertised monthly rent, not per-person rent.
GROUP_3_MAX_RENT_EUR=1500
GROUP_3_MIN_ROOMS=3
GROUP_2_MAX_RENT_EUR=1600
GROUP_2_MIN_ROOMS=2
LATEST_MOVE_IN_DATE=31.10.2026
POLL_SECONDS=60
LOOKBACK_DAYS=3

# Also search public listing pages directly. No Willhaben, WG-Gesucht or ÖH
# account credentials are needed. Direct sites are checked every 15 minutes so
# the bot does not put unnecessary load on them.
ENABLE_DIRECT_SEARCH=true
DIRECT_SCAN_SECONDS=900
DIRECT_SOURCE_TIMEOUT=20
DIRECT_POSTCODES="1020,1040,1050,1100"
DIRECT_MAX_DISTANCE_KM=4.0
WILLHABEN_MAX_PAGES=2

# Only fixed-duration offers in this range are forwarded. Twelve months is used
# as a tie-breaker after location and distance.
MIN_CONTRACT_MONTHS=6
MAX_CONTRACT_MONTHS=24
IDEAL_CONTRACT_MONTHS=12

# Missing contract terms are fetched from listing detail pages in parallel and
# cached in memory to reduce requests to the public sites.
CONTRACT_FETCH_WORKERS=4
CONTRACT_CACHE_SECONDS=21600

# A message must contain at least one of these terms. Add the sender name used
# by your page-monitor service if it differs.
ALERT_MATCH_TERMS="wg-gesucht,schwarzes brett,schwarzesbrett,visualping,distill,wohnung,wg-zimmer"
